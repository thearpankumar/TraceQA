# Line endings: LF in the repository and in every working tree, on every system, so files compare
# byte for byte on Windows too. Git decides per file whether it is text (text=auto).
* text=auto eol=lf

# Windows batch files only run with CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never converted, never diffed as text. tests/test_workflows.py checks that every
# tracked non-UTF-8 file matches one of these; the ones not tracked today are listed ahead of time.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.tgz binary
*.wasm binary

