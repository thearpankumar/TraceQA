{
  "name": "traceqa",
  "version": "0.1.0",
  "description": "TypeScript client for TraceQA. It starts the traceqa engine and talks to it; all logic lives in the engine.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen": "node scripts/gen-protocol.mjs",
    "gen:check": "node scripts/gen-protocol.mjs --check",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2"
  }
}
