{
  "name": "traceqa",
  "version": "0.1.0",
  "description": "TypeScript client for TraceQA. It starts the traceqa engine and talks to it; all logic lives in the engine.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node node_modules/typescript7/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:collector": "cd ../.. && node sdks/typescript/node_modules/eslint/bin/eslint.js -c sdks/typescript/eslint.collector.config.mjs collector/collector.js collector/pristine.js",
    "gen": "node scripts/gen-protocol.mjs",
    "gen:check": "node scripts/gen-protocol.mjs --check",
    "test": "npm run build && node --test dist/test/00-preflight.test.js && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm run typecheck && npm run build",
    "lint:package": "npm run build && publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "10.11.0",
    "json-schema-to-typescript": "^16.0.0",
    "publint": "0.3.25",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thearpankumar/TraceQA.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/thearpankumar/TraceQA/tree/master/sdks/typescript#readme",
  "bugs": {
    "url": "https://github.com/thearpankumar/TraceQA/issues"
  },
  "keywords": [
    "testing",
    "qa",
    "browser",
    "components",
    "traceqa",
    "playwright",
    "webdriver"
  ]
}
